<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Workstation GC: the Web SDK defaults to Server GC, whose per-core heaps (32 on the owner's PC) let a
         streaming animation's short-lived frame buffers pile up to hundreds of MB before any collection. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Glance.Core\Glance.Core.csproj" />
    <ProjectReference Include="..\Glance.Drivers.Thermalright\Glance.Drivers.Thermalright.csproj" />
    <ProjectReference Include="..\Glance.Sensors.Windows\Glance.Sensors.Windows.csproj" />
    <ProjectReference Include="..\Glance.Platform.Windows\Glance.Platform.Windows.csproj" />
  </ItemGroup>

  <Target Name="BuildWebUi" BeforeTargets="BeforePublish">
    <Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="Low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Exec Command="npm --version" ContinueOnError="true" StandardOutputImportance="Low">
      <Output TaskParameter="ExitCode" PropertyName="NpmExitCode" />
    </Exec>
    <Error Condition="'$(NodeExitCode)' != '0' Or '$(NpmExitCode)' != '0'" Text="Building Glance.Service for publish requires Node.js (>=20) and npm, but they were not found on PATH." />
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\web" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\web" />
  </Target>

  <Target Name="PublishWebUi" AfterTargets="BuildWebUi;CopyFilesToPublishDirectory">
    <ItemGroup>
      <_WebUiFiles Include="$(MSBuildThisFileDirectory)wwwroot\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebUiFiles)" DestinationFiles="@(_WebUiFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
